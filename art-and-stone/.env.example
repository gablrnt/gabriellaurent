# Copiez ce fichier en .env.local (développement) ou renseignez ces variables
# dans le tableau de bord Vercel / Netlify (production).

# Adresse publique du site, sans « / » final. Sert au SEO (sitemap, Open Graph)
# et aux liens de retour après paiement Stripe.
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Clé secrète Stripe (sk_live_… ou sk_test_…).
# Absente : pas de paiement en ligne, la commande est envoyée par e-mail et
# vous rappelez le client sous 24 h.
STRIPE_SECRET_KEY=

# Clé API Resend pour l'envoi des e-mails (commandes, contact).
# Absente : les demandes sont seulement écrites dans les journaux du serveur.
RESEND_API_KEY=

# Adresse qui reçoit les commandes et les messages du formulaire de contact.
ORDER_EMAIL_TO=

# (Facultatif) Expéditeur des e-mails, sur un domaine vérifié dans Resend.
# Par défaut : ART & STONE <onboarding@resend.dev> (réservé aux tests).
RESEND_FROM=
